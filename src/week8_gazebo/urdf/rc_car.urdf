<?xml version="1.0" ?>
<robot name="red_car" xmlns:xacro="http://ros.org/wiki/xacro">

  <!-- Materials -->
  <material name="red">
    <color rgba="1.0 0.0 0.0 1.0"/>
  </material>

  <material name="black">
    <color rgba="0.0 0.0 0.0 1.0"/>
  </material>

  <!-- Base Footprint -->
  <link name="base_footprint"/>

  <joint name="base_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <!-- Base Link -->
  <link name="base_link">
    <visual>
      <origin xyz="0 0 0.01875" rpy="0 0 0"/>
      <geometry>
        <box size="0.225 0.1125 0.075"/>
      </geometry>
      <material name="red"/>
    </visual>

    <collision>
      <origin xyz="0 0 0.01875" rpy="0 0 0"/>
      <geometry>
        <box size="0.225 0.1125 0.075"/>
      </geometry>
    </collision>

    <inertial>
      <origin xyz="0 0 0.01875" rpy="0 0 0"/>
      <mass value="168.75"/>
      <inertia ixx="56.25" ixy="0.0" ixz="0.0"
               iyy="168.75" iyz="0.0"
               izz="225.0"/>
    </inertial>
  </link>

  <!-- Wheels -->
  <link name="front_left_wheel">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder length="0.028125" radius="0.028125"/>
      </geometry>
      <material name="black"/>
    </visual>

    <collision>
      <geometry>
        <cylinder length="0.028125" radius="0.028125"/>
      </geometry>
    </collision>

    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="2.8125"/>
      <inertia ixx="0.140625" ixy="0.0" ixz="0.0"
               iyy="0.140625" iyz="0.0"
               izz="0.0703125"/>
    </inertial>
  </link>

  <joint name="front_left_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="front_left_wheel"/>
    <origin xyz="0.1125 0.05625 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
  </joint>

  <link name="front_right_wheel">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder length="0.028125" radius="0.028125"/>
      </geometry>
      <material name="black"/>
    </visual>

    <collision>
      <geometry>
        <cylinder length="0.028125" radius="0.028125"/>
      </geometry>
    </collision>

    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="2.8125"/>
      <inertia ixx="0.140625" ixy="0.0" ixz="0.0"
               iyy="0.140625" iyz="0.0"
               izz="0.0703125"/>
    </inertial>
  </link>

  <joint name="front_right_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="front_right_wheel"/>
    <origin xyz="0.1125 -0.05625 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
  </joint>

  <link name="rear_left_wheel">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder length="0.028125" radius="0.028125"/>
      </geometry>
      <material name="black"/>
    </visual>

    <collision>
      <geometry>
        <cylinder length="0.028125" radius="0.028125"/>
      </geometry>
    </collision>

    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="2.8125"/>
      <inertia ixx="0.140625" ixy="0.0" ixz="0.0"
               iyy="0.140625" iyz="0.0"
               izz="0.0703125"/>
    </inertial>
  </link>

  <joint name="rear_left_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="rear_left_wheel"/>
    <origin xyz="-0.1125 0.05625 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
  </joint>

  <link name="rear_right_wheel">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder length="0.028125" radius="0.028125"/>
      </geometry>
      <material name="black"/>
    </visual>

    <collision>
      <geometry>
        <cylinder length="0.028125" radius="0.028125"/>
      </geometry>
    </collision>

    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="2.8125"/>
      <inertia ixx="0.140625" ixy="0.0" ixz="0.0"
               iyy="0.140625" iyz="0.0"
               izz="0.0703125"/>
    </inertial>
  </link>

  <joint name="rear_right_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="rear_right_wheel"/>
    <origin xyz="-0.1125 -0.05625 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
  </joint>

  <!-- Camera -->
  <link name="camera_link">
    <collision>
      <origin xyz="0.0009375 0.0020625 0.0024375" rpy="0 0 0"/>
      <geometry>
        <box size="0.0028125 0.005625 0.0050625"/>
      </geometry>
    </collision>
  </link>

  <joint name="camera_joint" type="fixed">
    <origin xyz="0.0136875 -0.0020625 0.01575" rpy="0 0 0"/>
    <parent link="base_link"/>
    <child link="camera_link"/>
  </joint>

  <joint name="camera_rgb_joint" type="fixed">
    <origin xyz="0.0005625 0.0020625 0.0016875" rpy="0 0 0"/>
    <parent link="camera_link"/>
    <child link="camera_rgb_frame"/>
  </joint>

  <link name="camera_rgb_frame"/>

  <joint name="camera_rgb_optical_joint" type="fixed">
    <origin xyz="0 0 0" rpy="-1.57 0 -1.57"/>
    <parent link="camera_rgb_frame"/>
    <child link="camera_rgb_optical_frame"/>
  </joint>

  <link name="camera_rgb_optical_frame"/>

  <!-- IMU Sensor -->
  <link name="imu_link">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.1875"/>
      <inertia ixx="0.0001875" ixy="0.0" ixz="0.0"
               iyy="0.0001875" iyz="0.0"
               izz="0.0001875"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.009375 0.009375 0.009375"/>
      </geometry>
      <material name="black"/>
    </visual>
  </link>

  <joint name="imu_joint" type="fixed">
    <parent link="base_link"/>
    <child link="imu_link"/>
    <origin xyz="0 0 0.05625" rpy="0 0 0"/>
  </joint>

</robot>
