<?xml version="1.0"?>
<sdf version="1.6">
  <model name="simple_car">
    <static>false</static>
    <link name="base_link">
      <visual name="car_body_visual">
        <geometry>
          <box>
            <size>0.25 0.15 0.10</size> <!-- Width: 25cm, Length: 15cm, Height: 10cm -->
          </box>
        </geometry>
        <material>
          <ambient>0.8 0.2 0.2 1</ambient>
          <diffuse>0.8 0.2 0.2 1</diffuse>
        </material>
      </visual>

      <collision name="car_body_collision">
        <geometry>
          <box>
            <size>0.25 0.15 0.10</size>
          </box>
        </geometry>
      </collision>

      <inertial>
        <mass>1.0</mass>
        <inertia>
          <ixx>0.01</ixx>
          <iyy>0.01</iyy>
          <izz>0.01</izz>
        </inertia>
      </inertial>
    </link>

    <link name="wheel_front_left">
      <visual name="wheel_fl_visual">
        <geometry>
          <cylinder>
            <radius>0.025</radius> <!-- Radius: 25cm -->
            <length>0.01</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.1 0.1 0.1 1</ambient>
        </material>
      </visual>
    </link>

    <link name="wheel_front_right">
      <visual name="wheel_fr_visual">
        <geometry>
          <cylinder>
            <radius>0.025</radius> <!-- Radius: 25cm -->
            <length>0.01</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.1 0.1 0.1 1</ambient>
        </material>
      </visual>
    </link>

    <link name="wheel_rear_left">
      <visual name="wheel_rl_visual">
        <geometry>
          <cylinder>
            <radius>0.025</radius> <!-- Radius: 25cm -->
            <length>0.01</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.1 0.1 0.1 1</ambient>
        </material>
      </visual>
    </link>

    <link name="wheel_rear_right">
      <visual name="wheel_rr_visual">
        <geometry>
          <cylinder>
            <radius>0.025</radius> <!-- Radius: 25cm -->
            <length>0.01</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.1 0.1 0.1 1</ambient>
        </material>
      </visual>
    </link>
    <!-- Joints -->
    <joint name="wheel_left_joint" type="revolute">
      <parent>base_link</parent>
      <child>wheel_front_left</child>
      <axis>
        <xyz>0 1 0</xyz>
        <limit>
          <lower>-1.5708</lower>
          <upper>1.5708</upper>
        </limit>
      </axis>
    </joint>

    <joint name="wheel_right_joint" type="revolute">
      <parent>base_link</parent>
      <child>wheel_front_right</child>
      <axis>
        <xyz>0 1 0</xyz>
        <limit>
          <lower>-1.5708</lower>
          <upper>1.5708</upper>
        </limit>
      </axis>
    </joint>

    <joint name="joint_rear_left" type="revolute">
      <parent>base_link</parent>
      <child>wheel_rear_left</child>
      <axis>
        <xyz>0 1 0</xyz>
        <limit>
          <lower>-1.5708</lower>
          <upper>1.5708</upper>
        </limit>
      </axis>
    </joint>

    <joint name="joint_rear_right" type="revolute">
      <parent>base_link</parent>
      <child>wheel_rear_right</child>
      <axis>
        <xyz>0 1 0</xyz>
        <limit>
          <lower>-1.5708</lower>
          <upper>1.5708</upper>
        </limit>
      </axis>
    </joint>

    <!-- Plugins -->
    <plugin name="rc_car_diff_drive" filename="libgazebo_ros_diff_drive.so">
      <ros>
      </ros>
      <update_rate>30</update_rate>

      <!-- wheels -->
      <left_joint>wheel_left_joint</left_joint>
      <right_joint>wheel_right_joint</right_joint>

      <!-- kinematics -->
      <wheel_separation>0.14</wheel_separation>
      <wheel_diameter>0.06</wheel_diameter>

      <!-- limits -->
      <max_wheel_torque>20</max_wheel_torque>
      <max_wheel_acceleration>1.0</max_wheel_acceleration>

      <!-- command topic -->
      <command_topic>cmd_vel</command_topic>

      <!-- odometry settings -->
      <publish_odom>true</publish_odom>
      <publish_odom_tf>true</publish_odom_tf>
      <publish_wheel_tf>false</publish_wheel_tf>
      <odometry_topic>odom</odometry_topic>
      <odometry_frame>odom</odometry_frame>
      <robot_base_frame>base_footprint</robot_base_frame>
    </plugin>

    <plugin name="rc_car_joint_state" filename="libgazebo_ros_joint_state_publisher.so">
      <ros>
        <!-- <namespace>/rc_car</namespace> -->
        <remapping>~/out:=joint_states</remapping>
      </ros>
      <update_rate>30</update_rate>
      <joint_name>wheel_left_joint</joint_name>
      <joint_name>wheel_right_joint</joint_name>
    </plugin>
  </model>
  