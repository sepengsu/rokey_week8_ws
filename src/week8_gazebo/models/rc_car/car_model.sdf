<?xml version="1.0"?>
<sdf version="1.6">
  <model name="simple_car">
    <static>false</static>
    <link name="base_link">
    <pose>0 0 0.01 0 0 0</pose> <!-- 회전값 제거 -->
      <visual name="car_body_visual">
        <geometry>
          <box>
            <size>0.20 0.10 0.08</size> <!-- Width: 25cm, Length: 15cm, Height: 10cm -->
          </box>
        </geometry>
        <material>
          <ambient>1.0 0.5 0.0 1.0</ambient> <!-- Orange 색상 -->
          <diffuse>1.0 0.5 0.0 1.0</diffuse>
          <specular>0.5 0.5 0.5 1.0</specular>
        </material>
      </visual>
      <collision name="car_body_collision">
        <geometry>
          <box>
            <size>0.25 0.15 0.10</size>
          </box>
        </geometry>
      </collision>
      <inertial>
        <mass>1.0</mass>
        <inertia>
          <ixx>0.01</ixx>
          <iyy>0.01</iyy>
          <izz>0.01</izz>
        </inertia>
      </inertial>
    </link>
<!-- 여시거부터 -->
    <!-- Front Left Wheel -->
    <link name="wheel_front_left">
      <pose>-0.075 0.0575 -0.01 1.5708 0 0</pose> <!-- 회전값 제거 -->
      <inertial>
        <mass>0.1</mass>
        <inertia>
          <ixx>0.0001</ixx>
          <iyy>0.0001</iyy>
          <izz>0.0001</izz>
        </inertia>
      </inertial>
      <visual name="wheel_fl_visual">
        <geometry>
          <cylinder>
            <radius>0.03</radius>
            <length>0.015</length>
          </cylinder>
        </geometry>
      </visual>
      <collision name="wheel_fl_collision">
        <geometry>
          <cylinder>
            <radius>0.03</radius>
            <length>0.015</length>
          </cylinder>
        </geometry>
      </collision>
    </link>

    <joint name="joint_wheel_front_left" type="revolute">
      <pose>0 0 0 0 0 0</pose> <!-- 회전값을 조인트로 이동 -->
      <parent>base_link</parent>
      <child>wheel_front_left</child>
      <axis>
        <xyz>1 0 0</xyz> <!-- 축을 유지 -->
      </axis>
    </joint>

    <!-- Front Right Wheel -->
    <link name="wheel_front_right">
      <pose>-0.075 -0.0575 -0.01 1.5708 0 0</pose> <!-- 회전값 제거 -->
      <inertial>
        <mass>0.1</mass>
        <inertia>
          <ixx>0.0001</ixx>
          <iyy>0.0001</iyy>
          <izz>0.0001</izz>
        </inertia>
      </inertial>
      <visual name="wheel_fr_visual">
        <geometry>
          <cylinder>
            <radius>0.03</radius>
            <length>0.015</length>
          </cylinder>
        </geometry>
      </visual>
      <collision name="wheel_fr_collision">
        <geometry>
          <cylinder>
            <radius>0.03</radius>
            <length>0.015</length>
          </cylinder>
        </geometry>
      </collision>
    </link>

    <joint name="joint_wheel_front_right" type="revolute">
      <pose>0 0 0 0 0 0</pose> <!-- 회전값을 조인트로 이동 -->
      <parent>base_link</parent>
      <child>wheel_front_right</child>
      <axis>
        <xyz>1 0 0</xyz>
      </axis>
    </joint>

    <!-- Rear Left Wheel -->
    <link name="wheel_rear_left">
      <pose>0.075 0.0575 -0.01 1.5708 0 0</pose> <!-- 회전값 제거 -->
      <inertial>
        <mass>0.1</mass>
        <inertia>
          <ixx>0.0001</ixx>
          <iyy>0.0001</iyy>
          <izz>0.0001</izz>
        </inertia>
      </inertial>
      <visual name="wheel_rl_visual">
        <geometry>
          <cylinder>
            <radius>0.03</radius>
            <length>0.015</length>
          </cylinder>
        </geometry>
      </visual>
      <collision name="wheel_rl_collision">
        <geometry>
          <cylinder>
            <radius>0.03</radius>
            <length>0.015</length>
          </cylinder>
        </geometry>
      </collision>
    </link>

    <joint name="joint_wheel_rear_left" type="revolute">
      <pose>0 0 0 0 0 0</pose> <!-- 회전값을 조인트로 이동 -->
      <parent>base_link</parent>
      <child>wheel_rear_left</child>
      <axis>
        <xyz>1 0 0</xyz>
      </axis>
    </joint>

    <!-- Rear Right Wheel -->
    <link name="wheel_rear_right">
      <pose>0.075 -0.0575 -0.01 1.5708 0 0</pose> <!-- 회전값 제거 -->
      <inertial>
        <mass>0.1</mass>
        <inertia>
          <ixx>0.0001</ixx>
          <iyy>0.0001</iyy>
          <izz>0.0001</izz>
        </inertia>
      </inertial>
      <visual name="wheel_rr_visual">
        <geometry>
          <cylinder>
            <radius>0.03</radius>
            <length>0.015</length>
          </cylinder>
        </geometry>
      </visual>
      <collision name="wheel_rr_collision">
        <geometry>
          <cylinder>
            <radius>0.03</radius>
            <length>0.015</length>
          </cylinder>
        </geometry>
      </collision>
    </link>

    <joint name="joint_wheel_rear_right" type="revolute">
      <pose>0 0 0 0 0 0</pose> <!-- 회전값을 조인트로 이동 -->
      <parent>base_link</parent>
      <child>wheel_rear_right</child>
      <axis>
        <xyz>1 0 0</xyz>
      </axis>
    </joint>

<!-- 여시까지 -->


    <!-- Plugins -->
    <plugin name="rc_car_diff_drive" filename="libgazebo_ros_diff_drive.so">
      <ros>
        <remapping>~/cmd_vel:=cmd_vel</remapping>
      </ros>
      <update_rate>30</update_rate>
      <left_joint>joint_wheel_rear_left</left_joint>
      <right_joint>joint_wheel_rear_right</right_joint>
      <wheel_separation>0.085</wheel_separation>
      <wheel_diameter>0.06</wheel_diameter>
      <max_wheel_torque>20</max_wheel_torque>
      <max_wheel_acceleration>1.0</max_wheel_acceleration>
      <command_topic>cmd_vel</command_topic>
      <publish_odom>true</publish_odom>
      <publish_odom_tf>true</publish_odom_tf>
      <odometry_topic>odom</odometry_topic>
      <odometry_frame>odom</odometry_frame>
      <robot_base_frame>base_footprint</robot_base_frame>
    </plugin>

    <plugin name="rc_car_joint_state" filename="libgazebo_ros_joint_state_publisher.so">
      <ros>
        <remapping>~/out:=joint_states</remapping>
      </ros>
      <update_rate>30</update_rate>
      <joint_name>joint_wheel_rear_left</joint_name>
      <joint_name>joint_wheel_rear_right</joint_name>
      <joint_name>joint_wheel_front_left</joint_name>
      <joint_name>joint_wheel_front_right</joint_name>
    </plugin>
  </model>
</sdf>
